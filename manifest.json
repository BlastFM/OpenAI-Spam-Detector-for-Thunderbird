{
  "manifest_version": 3,
  "name": "Thunderbird OpenAI Spam Detector",
  "version": "1.2.0",
  "description": "AI-powered email filtering & custom training for Mozilla Thunderbird.",
  "permissions": [
    "storage",
    "downloads",
    "messagesRead",
    "messagesMove",
    "accountsRead",
    "menus",
    "tabs"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "openai-spam-detector@example.com",
      "strict_min_version": "102.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "options/popup.html",
    "default_icon": "icons/icon-48.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.png"
  }
}